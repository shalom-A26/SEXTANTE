# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
*.egg-info/

# OS
.DS_Store

# Secrets (token de Hugging Face)
.env

# Datos. Los stores son artefactos reconstruibles: la memoria persistente del
# proyecto es Hugging Face (`sync_hf --pull`), no el disco (ver AGENTS.md).
# Versionar `data/raw/vacantes.csv` rompía esa invariante —crecía en cada
# captura local y ensuciaba el working tree—; el directorio queda con un
# `.gitkeep` para que un clone limpio lo tenga.
data/snapshots/
data/raw/
!data/raw/.gitkeep
data/emitido/
data/duckdb/

# Artefactos analíticos reproducibles
data/procesados/grafos/*
!data/procesados/grafos/README.md
